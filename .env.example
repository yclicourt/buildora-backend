# Puerto del backend NestJS.
PORT=3001

# Postgres local (docker-compose.yml).
# Debe coincidir con POSTGRES_USER, POSTGRES_PASSWORD y POSTGRES_DB del compose.
DATABASE_URL=postgresql://buildora:buildora@localhost:5432/buildora

# Redis local (docker-compose.yml).
REDIS_URL=redis://localhost:6379

# JWT: los dos secretos son obligatorios (el servicio los exige con getOrThrow).
# Cambiar en cada entorno; nunca commitear valores reales aquí.
JWT_ACCESS_SECRET=cambia-este-secreto
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-este-otro-secreto
JWT_REFRESH_EXPIRES_IN=7d

# Orígenes CORS del frontend (opcionales).
ORIGIN_CLIENT_DEVELOPMENT=http://localhost:3000
ORIGIN_CLIENT_PRODUCTION=